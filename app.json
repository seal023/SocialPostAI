{
  "expo": {
    "name": "SocialPostAI_V2",
    "slug": "SocialPostAI_V2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seal.socialpostai",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "This app requires microphone access for voice input to generate social media copy."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "com.android.vending.BILLING",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.seal.socialpostai"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "28450087-a521-49ab-982c-b2fd96e55f53"
      }
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-audio",
      "expo-image-picker",
      "expo-apple-authentication",
      "expo-status-bar",
      "react-native-iap"
    ],
    "owner": "seal023"
  }
}
