# SocialPostAI 环境变量模板
# 复制为 .env 并填入真实 key（.env 已被 gitignore，不会进仓库）。
# Xcode Cloud 构建时，把这 3 个 EXPO_PUBLIC_* 设为 CI 环境变量即可，
# 不必把 .env 提交进仓库。

# 阿里云百炼 / DashScope（模型生成文案）
EXPO_PUBLIC_BAILIAN_API_KEY=
EXPO_PUBLIC_DASHSCOPE_API_KEY=

# 实时语音识别（ASR，须新加坡/北京区 key；美国区 key 无法用于实时 ASR）
EXPO_PUBLIC_ASR_API_KEY=
